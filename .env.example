# NEUROPULSE environment configuration
#
# neuPrint authentication token.
# Obtain from https://neuprint.janelia.org -> account menu (top-right avatar) -> "Account"
# The token is a long JWT string. Keep it secret; never commit the real .env.
NEUPRINT_TOKEN=

# neuPrint server hosting the MaleCNS reconstruction
NEUPRINT_SERVER=https://neuprint.janelia.org

# Dataset identifier. NEUROPULSE targets the adult male Drosophila CNS v1.0.
NEUPRINT_DATASET=male-cns:v1.0

# Local cache directory for queried biological data (relative to repo root)
NEUROPULSE_DATA_DIR=data

# Backend bind address for the FastAPI dev server
NEUROPULSE_HOST=127.0.0.1
NEUROPULSE_PORT=8000

# Optional external scene interpretation (selected by the user in the UI).
# Server-side only. Never put this key in VITE_* variables.
GEMINI_API_KEY=
NEUROPULSE_LLM_MODEL=gemini-3.5-flash-lite
